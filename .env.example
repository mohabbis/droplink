# All variables are optional. Copy to .env for local development.

# Port for `npm start` (production server) and `npm run dev:server` (signaling only).
PORT=8787

# JSON array of RTCIceServer objects sent to browsers. Defaults to Google's public STUN server.
# Add a TURN server for networks where a direct connection is impossible, e.g.:
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]
# Set to [] to use host candidates only (same network / local testing).
ICE_SERVERS=

# How long an unpaired room stays open, in seconds. Keep this below the Vercel function maxDuration.
ROOM_TTL_SECONDS=270

# Global room cap per server instance.
MAX_ROOMS=1000
